# large data
*.xyz
*.pth
*.ckpt
*.lammpstrj*
*.tar
*.tar.gz
*.zip
*.npy
!results/fps/**/*.npy
results/timing_cpu/
env/venv*/
__pycache__/
*.pyc
outputs/
slurm_output/
*.egg-info/
results/pruned/
results/paper/rdf_data_summary.json
# external datasets
data/external/*/*.xyz
results/test_distance/nn_distances.csv
results/test_distance/test_descriptors.npy
results/test_distance/nn_distances.csv
*.core
!results/ext/*/fps/**/*.npy
results/ext/*/test_distance/*.npy
results/ext/*/test_distance/nn_distances.csv

# training outputs / smoke tests
results/models
results/ext/*/models
results/smoke/
results/smoke_login/
# Stampede3 debug logs (failed smoke tests); h100 train-*/eval-* logs stay committed
results/slurm/smoke-*.out
# regenerated by training/make_training_sets_*.sh (as results/pruned/ for carbon);
# the adaptive budgets' summaries are kept as committed overall-retention records
results/ext/*/pruned/*
!results/ext/*/pruned/adaptive_*/
